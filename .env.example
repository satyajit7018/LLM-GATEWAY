# Copy to .env and edit to use real services. All optional — defaults run
# fully offline (mock LLM + lexical semantic cache + in-memory store), no setup.

# --- LLM backend ---
# LLM_BACKEND=groq
# LLM_API_KEY=your_groq_key_here          # get one at https://console.groq.com/keys
# LLM_MODEL=llama-3.1-8b-instant
# LLM_VISION_MODEL=qwen/qwen3.6-27b     # used when a request includes images
# MOCK_LATENCY_S=1.8                       # mock backend only
# MOCK_FAIL_RATE=0.0                       # inject failures to exercise retries
# COST_PER_1K_TOKENS=0.05

# --- local code execution ---
# The code editor can run projects with the real interpreters on this machine
# (Python/Node/Bash/…). This executes arbitrary code with the server's
# privileges — keep the server on localhost. On by default; set to 0 to disable.
# ENABLE_LOCAL_RUN=1
# RUN_TOKEN=some-secret        # require X-Run-Token header on /run + /workspace
# RUN_ALLOW_REMOTE=0           # 1 lets non-local clients run code (behind your own auth!)

# --- Exact cache (Redis) ---
# REDIS_URL=redis://localhost:6379/0       # e.g. docker run -p 6379:6379 redis
# CACHE_TTL_S=86400

# --- Semantic cache ---
# EMBED_BACKEND=sbert                      # real paraphrase matching (needs
#                                          # pip install sentence-transformers)
# SEMANTIC_THRESHOLD=0.82
# SEMANTIC_CACHE_ENABLED=1

# --- Rate limiting + resilience ---
# RATE_LIMIT_RPS=50                        # GLOBAL cap shared by every request
# RATE_LIMIT_BURST=100
# Per-account cap (hybrid multi-user build) so one busy user can't 429 everyone
# else by exhausting the global budget alone. Falls back to per-IP when nobody
# is logged in. Deliberately tighter than the global default.
# PER_USER_RATE_LIMIT_RPS=10
# PER_USER_RATE_LIMIT_BURST=20
# LLM_MAX_RETRIES=3
# CIRCUIT_FAIL_THRESHOLD=5
# CIRCUIT_RESET_S=10

# --- Accounts (hybrid multi-user build) ---
# AUTH_REQUIRED=1                          # require sign-in to chat; 0 to disable accounts
# COOKIE_SECURE=1                          # MUST be 1 behind HTTPS in any public deployment
# AUTH_DB_PATH=./app_data.db               # user accounts + sessions + BYO keys

# Encrypts users' bring-your-own provider API keys at rest. Required for the
# "Connections" (add your own key) feature — without it, BYO keys are disabled.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet as F; print(F.generate_key().decode())"
# APP_ENCRYPTION_KEY=

# Daily token cap per user on the app's OWN keys ("free" models) — bounds your
# free-tier cost exposure from open signup. BYO-key calls never count against
# it. Resets at UTC midnight. 0 = unlimited.
# FREE_DAILY_TOKEN_LIMIT=50000

# Require a one-time invite code to sign up (instead of open registration).
# Generate codes with: python -m scripts.create_invite
# SIGNUP_REQUIRES_INVITE=1

# Password-reset email. Without SMTP configured, reset links are logged to the
# server console instead — fine for local/demo, not for a public deployment.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@yourdomain.com
# PUBLIC_BASE_URL=http://localhost:8000     # used to build the link in the email
